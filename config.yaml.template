# SunRay2Server configuration template.
# Copy this file to config.yaml and adjust the VNC address before deployment.
version: 1

server:
  listen: ":7009"
  fallback_width: 1280
  fallback_height: 1024
  # Optional logical canvas override. This limits framebuffer/VNC traffic but
  # does not change the physical DVI timing selected by the Sun Ray firmware.
  # Set both values or leave both commented.
  # A Sun Ray 2 connected to a 1920x1080 monitor was measured as a 1400x1050
  # usable viewport. Calibrate your own terminal before enabling an override.
  # display_width: 1400
  # display_height: 1050
  packet_delay: 200us
  smartcard_listen: ""
  # Disabled by default because pointer motion can generate hundreds of events.
  log_input_events: false
  # Docker Desktop proxies host-network TCP connections and may report ::1
  # instead of the terminal's real address. Map each affected Sun Ray serial to
  # its stable IPv4 address so the UDP display channel reaches the terminal.
  # terminal_ips:
  #   "00144fd19044": 192.168.30.153

sessions:
  card-test:
    type: card-test
    # Optional PNG/JPEG. Relative paths are resolved from this config file.
    # image: ./assets/card-test.png

  # Interactive viewport calibration. Route a card state to this session, then
  # use the arrow keys until all four colored edges fit without panning.
  geometry-test:
    type: geometry-test

  example-vnc:
    type: vnc
    address: 192.168.30.10:5900
    # current  = fit the full VNC desktop into the calibrated/global size
    # terminal = fit it into the original startRes reported by the Sun Ray
    # vnc      = native VNC framebuffer size, including later resizes
    # manual   = fit it into this session's display_width/display_height below
    resolution_mode: current
    # display_width: 1400
    # display_height: 1050
    # Passwords belong to each session, so multiple VNC sessions may use
    # different values. Leave both fields empty for Security None. For simple
    # private-LAN testing, uncomment the following line:
    # password: change-me
    # For a deployed system, prefer a mounted secret instead. Do not set both.
    # password_file: /run/secrets/vnc_password

  # second-vnc:
  #   type: vnc
  #   address: 192.168.30.11:5900
  #   password: another-password

  # SSH is implemented with a PTY and framebuffer terminal. For a quick test,
  # use an inline password and explicitly opt into insecure host-key handling.
  # For normal use, replace that flag with known_hosts_file or host_key_sha256.
  # example-ssh:
  #   type: ssh
  #   hostname: 192.168.30.20
  #   port: 22
  #   username: user
  #   password: change-me
  #   insecure_ignore_host_key: true
  #   # Optional UTF-8 font. Relative paths resolve from this config file.
  #   # Use a monospace CJK/Powerline font when those glyphs are needed.
  #   font_file: ./assets/NotoSansMonoCJK-Regular.otf
  #   font_size: 20
  #   # known_hosts_file: /run/secrets/ssh_known_hosts
  #   # host_key_sha256: SHA256:replace-with-server-fingerprint
  #   private_key_file: /run/secrets/ssh_private_key
  #
  # RDP uses FreeRDP in an isolated virtual X display. The Docker image includes
  # all helper programs; a native installation needs Xvfb, x11vnc and xfreerdp.
  # example-rdp:
  #   type: rdp
  #   hostname: 192.168.30.30
  #   port: 3389
  #   username: user
  #   # domain: WORKGROUP
  #   password: change-me
  #   # password_file: /run/secrets/rdp_password
  #   # current, terminal, or manual (same meanings as the VNC modes above).
  #   resolution_mode: current
  #   # display_width: 1400
  #   # display_height: 1050
  #   # Secure default is deny. Many test servers use a self-signed certificate;
  #   # use ignore only on a trusted LAN, or configure name:/fingerprint: instead.
  #   certificate: ignore

routing:
  # Current Sun Ray 2 behavior:
  #   no_card      = pseudo token, no physical card inserted
  #   card_present = physical card detected, even when its ID is all zeroes
  default:
    no_card: card-test
    card_present: example-vnc
    # For calibration, temporarily use:
    # no_card: geometry-test

    # Exact IDs override card_present when the terminal can report a real ID.
    # cards:
    #   "0x0123456789abcdef": example-vnc

  # Terminal-specific routes override the defaults above. Matching is
  # case-insensitive. Exact terminal card IDs have the highest priority.
  terminals:
    "00144fd19044":
      no_card: card-test
      card_present: example-vnc
      # cards:
      #   "0x0123456789abcdef": example-vnc
